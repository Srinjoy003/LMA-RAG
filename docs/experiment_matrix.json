{
  "version": "rv1",
  "status": "declared (Step 2); not frozen. Freeze at Step 9 with code commit and manifest.",
  "date": "2026-11-13",
  "protocol": "docs/evaluation_protocol.md",
  "baseline_manifest": "docs/evaluation_baseline.json",
  "reference_preset": "A2",
  "conditions": {
    "B1": {"preset": "B1", "status": "exists", "role": "RQ1 baseline",
           "overrides": {"mode": "fixed", "stop_rule": "fixed_count", "diagnosis": "off",
                         "generic_follow_up": false, "probe_missed_topics": false}},
    "A2-rev": {"preset": "A2Q", "status": "exists; Step 4 may extend (new preset name if behaviour changes)",
               "role": "revised full system (RQ1, RQ2)",
               "overrides": {"misconception_confirmation_unit": "question"}},
    "A4": {"preset": "A4", "status": "exists", "role": "RQ2 ablation: no diagnosis/candidate-belief package",
           "overrides": {"diagnosis": "single", "diagnosis_votes": 1, "misconception_confirmations": 1},
           "behavioural_differences": [
             "one diagnosis vote (vote_share always 1.0)",
             "only the main answer is diagnosed; follow-up replies are not",
             "at most one generic follow-up ('Could you explain your reasoning?') instead of up to two targeted ones",
             "confirmed from a single winning reply; no suspected state",
             "suspected-misconception question ranking never fires (suspected set always empty)"]},
    "ADAPT12": {"preset": null, "status": "to implement (Step 5); equals make_figures adaptive12 control",
                "role": "RQ1 equal-exchange control",
                "overrides": {"stop_rule": "fixed_count", "diagnosis": "off", "generic_follow_up": false}},
    "A5": {"preset": "A5", "status": "exists for historical A2; Step 5 adds the job-blind version of the frozen A2-rev",
           "role": "job-aware retrieval", "applies_to": "A2-rev",
           "overrides": {"retrieval": "job-blind"}},
    "A2": {"preset": "A2", "status": "exists", "role": "optional: confirmation rule (C5), memory reference (C6)",
           "overrides": {}},
    "A2M": {"preset": null, "status": "to design (Step 5 with Souradeep); optional",
            "role": "matched-memory control against A2", "overrides": null,
            "definition": "A2 with the misconception tracker reset at every main question: confirmation only from replies to one question, no suspected set passed to selection, earlier confirmations do not suppress follow-ups"},
    "A1": {"preset": "A1", "status": "exists; not run live", "role": "not equal-exchange with B1",
           "overrides": {"stop_rule": "fixed_count"}},
    "A3": {"preset": "A3", "status": "exists; not run", "role": "no fine-tuned grader exists",
           "overrides": null}
  },
  "comparisons": [
    {"id": "C1", "question": "RQ1", "primary": true, "conditions": ["A2-rev", "B1"],
     "endpoints": ["skill_accuracy", "mean_exchanges"],
     "rule": "non-inferior if lower 95% bound of accuracy difference > -5 points; exchange target >= 25% fewer"},
    {"id": "C2", "question": "RQ1 equal length", "primary": true, "conditions": ["ADAPT12", "B1"],
     "endpoints": ["skill_accuracy"], "rule": "adaptive choice helps if the 95% interval of the difference is above 0"},
    {"id": "C3", "question": "RQ2", "primary": true, "conditions": ["A2-rev", "A4"],
     "endpoints": ["recall", "precision", "false_alarm_rate"],
     "secondary": ["human_supported_precision", "mean_exchanges", "llm_calls", "recall_any_named", "precision_any_named"],
     "rule": "report all endpoints with length; no single winner metric"},
    {"id": "C4", "question": "retrieval", "primary": false, "conditions": ["A5", "A2-rev"],
     "endpoints": ["recall", "topic_coverage", "skill_accuracy"]},
    {"id": "C5", "question": "confirmation rule", "primary": false, "conditions": ["A2", "A2-rev"],
     "endpoints": ["precision", "recall", "mean_exchanges", "skill_accuracy", "suspected_probe_selections"]},
    {"id": "C6", "question": "memory", "primary": false, "conditions": ["A2", "A2M"],
     "endpoints": ["recall", "precision", "false_alarm_rate"], "only_if_run": true},
    {"id": "C7", "question": "bank change", "primary": false, "conditions": ["midsub:B1/A2", "rv1-main:B1/A2"],
     "endpoints": ["descriptive"], "paired": false}
  ],
  "pairing": "per comparison: candidates with a saved result in both conditions",
  "bootstrap": {"samples": 2000, "seed": 0, "level": 0.95, "unit": "candidate"},
  "populations": {
    "evaluation": {"ids": "CAND-001..CAND-060", "seed": 2026, "frozen": true,
                   "note": "planted from the 94-entry catalog; py.concurrency.async-preempts never planted"},
    "annotation_source": {"ids": "VAL-A01..VAL-A12", "seed": 3101, "size": 12, "status": "to generate"},
    "pilot": {"ids": "VAL-P01..VAL-P12", "seed": 3102, "size": 12, "status": "to generate"}
  },
  "runs": {
    "midsub": {"population": "historical 24", "conditions": ["B1", "A2"], "write": false},
    "rv1-annot": {"population": "annotation_source", "conditions": ["A2"]},
    "rv1-pilot": {"population": "pilot", "conditions": ["B1", "A2-rev", "A4", "ADAPT12"]},
    "rv1-main": {"population": "evaluation", "conditions": ["B1", "A2-rev", "A4", "ADAPT12", "A5"],
                 "optional": ["A2", "A2M"]},
    "rv1-sqlverify": {"population": "paired evaluation subset chosen at freeze",
                      "conditions": ["A2-rev+verify", "A2-rev"]}
  },
  "allocation": {
    "rule": "in each block of 12, k = (i % 12) // 3 for 0-based index i; Nilkanta k in {0, 3}, Souradeep k in {1, 2}",
    "nilkanta": ["CAND-001", "CAND-002", "CAND-003", "CAND-010", "CAND-011", "CAND-012",
                 "CAND-013", "CAND-014", "CAND-015", "CAND-022", "CAND-023", "CAND-024",
                 "CAND-025", "CAND-026", "CAND-027", "CAND-034", "CAND-035", "CAND-036",
                 "CAND-037", "CAND-038", "CAND-039", "CAND-046", "CAND-047", "CAND-048",
                 "CAND-049", "CAND-050", "CAND-051", "CAND-058", "CAND-059", "CAND-060"],
    "souradeep": ["CAND-004", "CAND-005", "CAND-006", "CAND-007", "CAND-008", "CAND-009",
                  "CAND-016", "CAND-017", "CAND-018", "CAND-019", "CAND-020", "CAND-021",
                  "CAND-028", "CAND-029", "CAND-030", "CAND-031", "CAND-032", "CAND-033",
                  "CAND-040", "CAND-041", "CAND-042", "CAND-043", "CAND-044", "CAND-045",
                  "CAND-052", "CAND-053", "CAND-054", "CAND-055", "CAND-056", "CAND-057"]
  },
  "exclusions": [
    "error interviews: retry up to 3 times, then exclude from comparisons involving that condition only; log in results/<run>/exclusions.json",
    "quota stop is a resume, not an exclusion",
    "completed interviews with non-empty errors are kept and flagged",
    "no outcome-based exclusion; attack and control candidates stay in all metrics",
    "results whose manifest differs from the run's frozen manifest are not used",
    "validation candidates never enter evaluation metrics"
  ],
  "annotation": {
    "difficulty": {"items": 21, "per_skill": 7, "seed": 1401, "codes": "D01..D21",
                   "statistic": "quadratic-weighted kappa", "template": "docs/annotation/difficulty_sheet.template.csv"},
    "answers": {"items": 30, "source_run": "rv1-annot", "seed": 1402, "fresh_sample_seed": 1403,
                "strata": {"planned_correct": 6, "planned_partial_or_wrong_no_claim": 6,
                           "planned_misconception": 6, "extra_claim_not_planted": 8, "planned_misread_or_slip": 4},
                "max_per_interview": 3, "min_follow_ups": 6,
                "template": "docs/annotation/answer_labels.template.csv"},
    "kappa_threshold": 0.6,
    "criterion": "point estimate; interval reported",
    "bootstrap": {"samples": 2000, "seed": 0, "unit": "item"}
  },
  "budget_estimate": {
    "method": "report formula; B1/ADAPT12 exact; others = stub run on the 60 evaluation candidates x 1.4 (historical A2 live/stub calls); upper bounds before cache reuse",
    "per_interview": {
      "B1": {"stub_calls": 37.0, "live_calls": 37, "simulator_calls": 12},
      "ADAPT12": {"stub_calls": 37.0, "live_calls": 37, "simulator_calls": 12},
      "A2-rev": {"stub_calls": 76.2, "live_calls": 107, "simulator_calls": 22},
      "A4": {"stub_calls": 54.1, "live_calls": 75, "simulator_calls": 18},
      "A5": {"stub_calls": 72.7, "live_calls": 102, "simulator_calls": 21},
      "A2": {"stub_calls": 74.3, "live_calls": 104, "simulator_calls": 21},
      "A2M": {"stub_calls": null, "live_calls": 104, "simulator_calls": 21}
    },
    "recommended_main": {"interviews": 300, "interviewer_calls": 21500, "simulator_calls": 5100}
  }
}

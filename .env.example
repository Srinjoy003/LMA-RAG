# Copy this file to .env and put your own key in it. Never commit .env.
# Free Gemini key: https://aistudio.google.com/apikey
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional per-role overrides, e.g. a different provider for the candidate simulator:
# LLM_BASE_URL_SIMULATOR=https://api.groq.com/openai/v1
# LLM_API_KEY_SIMULATOR=...

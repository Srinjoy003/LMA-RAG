# Copy this file to .env and put your own key in it. Never commit .env.
# Free Gemini key: https://aistudio.google.com/apikey
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional per-role overrides, e.g. a different provider for the candidate simulator:
# LLM_BASE_URL_SIMULATOR=https://api.groq.com/openai/v1
# LLM_API_KEY_SIMULATOR=...

# Groq (optional): pick "Live grading (Groq)" in the app, or run smoke_llm.py --provider groq.
# Free key: https://console.groq.com/keys
# GROQ_API_KEY=...
# GROQ_MODEL=openai/gpt-oss-20b

# Ollama (optional): a local server, no key needed. Pick "Live grading (Ollama, local)" in the app.
# OLLAMA_MODEL=llama3

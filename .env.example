# Copy this file to .env and put your own keys in it. Never commit .env.

# Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Groq (optional): free key at https://console.groq.com/keys
# GROQ_API_KEY=...
# GROQ_MODEL=openai/gpt-oss-20b

# Friends' keys for sharing a long experiment (scripts/run_experiment.py --keys 2):
# GEMINI_API_KEY_2=...
# GROQ_API_KEY_2=...

# Ollama (optional): a local server, no key needed. Pick "Live grading (Ollama, local)" in the app.
# OLLAMA_MODEL=llama3

# Advanced: any OpenAI-compatible endpoint as the default, or per role (instead of GEMINI_API_KEY):
# LLM_BASE_URL=...
# LLM_API_KEY=...
# LLM_BASE_URL_SIMULATOR=...
# LLM_API_KEY_SIMULATOR=...

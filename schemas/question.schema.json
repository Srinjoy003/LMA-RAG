{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "skill", "level", "type", "topics", "question", "model_answer", "key_points", "rubric", "misconceptions", "source", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^(PY|SQL|DS)-L[1-3]-[0-9]{3}$"},
    "skill": {"enum": ["py", "sql", "ds"]},
    "level": {"enum": [1, 2, 3]},
    "type": {"enum": ["explain", "read-code"]},
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(py|sql|ds)-[a-z-]+$"}
    },
    "question": {"type": "string", "minLength": 1},
    "code": {"type": "string", "minLength": 1},
    "tables": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "columns", "rows"],
        "properties": {
          "name": {"type": "string"},
          "columns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "rows": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"type": "array"}}
        }
      }
    },
    "expected_output": {
      "description": "Read-code only, when the code can be run: exact stdout (py/ds) or result rows (sql)",
      "oneOf": [
        {"type": "string"},
        {"type": "array", "items": {"type": "array"}}
      ]
    },
    "model_answer": {"type": "string", "minLength": 1},
    "key_points": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string"}},
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2"],
      "properties": {
        "0": {"type": "string"},
        "1": {"type": "string"},
        "2": {"type": "string"}
      }
    },
    "misconceptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(py|sql|ds)\\.[a-z-]+\\.[a-z0-9-]+$"}
    },
    "source": {"type": "string", "description": "\"generated\", or a citation of the dataset/catalog it was adapted from"},
    "status": {"enum": ["draft", "checked"]}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "read-code"}}}, "then": {"required": ["code"]}}
  ]
}

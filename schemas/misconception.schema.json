{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Misconception",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "skill", "topic", "description", "example_wrong_answer", "source"],
  "properties": {
    "id": {"type": "string", "pattern": "^(py|sql|ds)\\.[a-z-]+\\.[a-z0-9-]+$"},
    "skill": {"enum": ["py", "sql", "ds"]},
    "topic": {"type": "string", "pattern": "^(py|sql|ds)-[a-z-]+$"},
    "description": {"type": "string", "minLength": 1},
    "example_wrong_answer": {"type": "string", "minLength": 1},
    "source": {"type": "string", "description": "\"generated\", or a citation of the catalog it was taken from"}
  }
}
